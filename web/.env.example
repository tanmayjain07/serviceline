# Copy to .env.local for local overrides. Both are gitignored.
#
# Neither variable is needed for normal local development: the Vite dev server
# proxies /api to http://127.0.0.1:8000, so the defaults just work.

# Full URL of the deployed API, including the /api/v1 prefix. Only set this when
# the frontend and API are on different hosts, which is the case in production.
# VITE_API_BASE_URL=https://serviceline-api.onrender.com/api/v1

# Shows the published demo credentials on the login page. Only ever 'true' on
# the public demo deployment.
# VITE_DEMO_MODE=true
