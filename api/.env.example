# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development

# Runtime connection: the low-privilege application role.
# This role owns nothing and has no BYPASSRLS, so row-level security applies to
# every query the API makes. The app refuses to start if this is not true.
DATABASE_URL=postgresql+psycopg://serviceline_app:app_dev_2026@localhost:5432/serviceline

# Migrations only: the owning role. Never used at runtime.
DATABASE_ADMIN_URL=postgresql+psycopg://serviceline_owner:owner_dev_2026@localhost:5432/serviceline

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

INVITE_EXPIRY_DAYS=7
TRIAL_DAYS=14

CORS_ORIGINS=["http://localhost:5173"]
SQL_ECHO=false
